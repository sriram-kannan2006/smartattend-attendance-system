# Environment Configuration
NODE_ENV=production
PORT=5000
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/attendance_system?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d
FRONTEND_URL=https://your-frontend-domain.com

# SMTP Email Configuration (Gmail App Password)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com
ATTENDANCE_REPORT_EMAIL=hod_ece@kongu.ac.in

# Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend-domain.com/api/auth/google/callback
